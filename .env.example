# Database
DB_PASSWORD=changeme_local_dev
DATABASE_URL=postgresql+asyncpg://researcher:changeme_local_dev@db:5432/equity_research

# ── LLM backend ───────────────────────────────────────────────────────────────────────────────────
# Two environments, selected by APP_ENV (loads backend/config/<APP_ENV>.yaml):
#   dev  (DEFAULT, local docker)  → llm_backend=claude_code → bills your Max/Pro SUBSCRIPTION
#   prod (servers)                → llm_backend=api         → bills ANTHROPIC_API_KEY
# Run prod with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up
APP_ENV=dev

# DEV (subscription): generate once on the HOST with `claude setup-token` (Claude subscription
# required), paste here. Long-lived (~1 year), auto-refreshes; treat as a secret (it's account access).
CLAUDE_CODE_OAUTH_TOKEN=

# Keep Claude account Settings > Usage > Usage credits OFF to prevent paid subscription overage.
# PROD (API key): only needed when APP_ENV=prod. Leave blank in dev to avoid API-key billing.
ANTHROPIC_API_KEY=

# News API (https://newsapi.org)
NEWS_API_KEY=xxxxx

# Financial Modeling Prep (https://financialmodelingprep.com — free tier, 250 calls/day)
FMP_API_KEY=xxxxx

# App
ENV=development
LOG_LEVEL=INFO
